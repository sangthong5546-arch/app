    {
      "id": "kyocera_m2040dn",
      "name": "Kyocera M2040dn KX Driver",
      "description": "ไดรเวอร์เครื่องพิมพ์ Kyocera M2040dn",
      "category": "Printer Drivers",
      "windows": {
        "url": "https://www.kyoceradocumentsolutions.com/en/support/downloads.html",
        "installer_type": "manual",
        "manual_steps": [
          "1. ไปที่เว็บไซต์ Kyocera Support: https://www.kyoceradocumentsolutions.com",
          "2. คลิก Support > Download Center",
          "3. ค้นหา 'ECOSYS M2040dn'",
          "4. เลือกระบบปฏิบัติการ (Windows 10/11 64-bit)",
          "5. ดาวน์โหลด 'KX Driver' (ประมาณ 20-30 MB)",
          "6. เปิดไฟล์ .exe ที่ดาวน์โหลดมา",
          "7. ทำตามขั้นตอนการติดตั้ง (Next > Agree > Install)",
          "8. เชื่อมต่อเครื่องพิมพ์ผ่าน USB หรือ Network",
          "9. รีสตาร์ทเครื่องหากจำเป็น"
        ],
        "note": "ไดรเวอร์ Kyocera ต้องดาวน์โหลดจากเว็บไซต์โดยตรงเนื่องจาก URL เปลี่ยนแปลงบ่อย"
      },
      "linux": {
        "url": "https://www.kyoceradocumentsolutions.com/en/support/downloads.html",
        "installer_type": "manual",
        "manual_steps": [
          "1. ไปที่เว็บไซต์ Kyocera Support: https://www.kyoceradocumentsolutions.com",
          "2. คลิก Support > Download Center",
          "3. ค้นหา 'ECOSYS M2040dn'",
          "4. เลือกระบบปฏิบัติการ Linux",
          "5. ดาวน์โหลด Linux Driver Package (.tar.gz)",
          "6. แตกไฟล์: tar -xzf [filename].tar.gz",
          "7. เข้าไปในโฟลเดอร์: cd [foldername]",
          "8. รันสคริปต์ติดตั้ง: sudo ./install.sh",
          "9. ตั้งค่าเครื่องพิมพ์ผ่าน CUPS: http://localhost:631",
          "10. เพิ่มเครื่องพิมพ์และเลือกไดรเวอร์ Kyocera M2040dn"
        ],
        "note": "ต้องดาวน์โหลดไดรเวอร์ Linux Package จากเว็บไซต์ Kyocera เนื่องจากไม่มีใน repository"
      }
    },
